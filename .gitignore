*.log

node_modules/

# graphify 本地知识图谱导出，可出现在仓库任意层级，不入库。
graphify-out/

# Python（adapters_tests 抓包/逆向实验用的本地虚拟环境与缓存，不入库）
.venv/
__pycache__/
*.pyc

# 真实学校接口本机采样原件：可能含学生隐私/凭证等价物，永不入库（红线 #1/#8）。
.private-probes/

# OHOS 构建环境：含机器相关绝对路径，仅 .example 入库（见 tools/ohos/README.md）
tools/ohos/env.sh
.envrc

# OHOS 签名材料（红线 #4：签名密钥/口令绝不入库）与本机构建产物
tools/ohos/sign*.env
client/ohos/local.properties
client/ohos/.hvigor/
client/ohos/oh_modules/

# npm workspace 共享包构建产物（prepare 时由 tsc 生成）
packages/*/dist/
server/dist/

# 按需拉取的 elecon-adapters 缓存（ADR-018 §2.11.1，取代 git 子模块）。
# 由 scripts/fetch-adapters.sh 按 adapters.pin 克隆，不入库。
.adapters-cache/

# YubiKey PIV 签名 ceremony 的本机产物（ADR-002 §2.3、docs/reference/signing_ceremony.md）。
# 公钥不敏感，但**无需入库**：它随时可从令牌重新读出（`pkcs11.ts pubkey`，无需 PIN），
# 而信任锚的权威副本是 App 内预埋的 pin——散落的 .pem 只会和作废密钥混淆（2026-07-16 即发生过）。
# 私钥不可能出现在此：它片上生成、永不导出。
*.pem

# 签名仪式 / dist:export 产出的端点 D dist 树：不入库（2026-09-11 决策）。
# git 只跟踪它的派生物 client/assets/bootstrap/（bootstrap:sync），上传前用 dist:export 反向导出。
/dist/
/dist-*/
