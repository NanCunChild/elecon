            <parameter-binding android:key="feature" android:value="@array/shortcut_exam_aliases" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="classroom" android:shortcutShortLabel="@string/shortcut_classroom" android:shortcutLongLabel="@string/shortcut_classroom" android:icon="@drawable/shortcut_classroom">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="@APPLICATION_ID@" android:targetClass="dev.nancunchild.elecon.MainActivity" android:data="elecon://feature/classroom" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding android:key="feature" android:value="@array/shortcut_classroom_aliases" />
        </capability-binding>
    </shortcut>
    <!-- App Actions entity inventory intentionally has no intent/shortLabel/longLabel.
         It is excluded from Launcher shortcuts, per Android's action-schema and
         inline-inventory documentation. Do not add labels just to silence the
         Launcher parser's missing-shortLabel diagnostic. -->
    <shortcut android:shortcutId="card">
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding android:key="feature" android:value="@array/shortcut_card_aliases" />
