<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-085: applicationId is substituted per variant, including DEV-SIDELOAD. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="@APPLICATION_ID@" android:targetClass="dev.nancunchild.elecon.MainActivity">
            <url-template android:value="elecon://feature/{featureId}" />
            <parameter android:name="feature" android:key="featureId" android:required="true" />
        </intent>
        <intent android:action="android.intent.action.MAIN" android:targetPackage="@APPLICATION_ID@" android:targetClass="dev.nancunchild.elecon.MainActivity" />
    </capability>
    <shortcut android:shortcutId="schedule" android:shortcutShortLabel="@string/shortcut_schedule" android:shortcutLongLabel="@string/shortcut_schedule" android:icon="@drawable/shortcut_schedule">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="@APPLICATION_ID@" android:targetClass="dev.nancunchild.elecon.MainActivity" android:data="elecon://feature/schedule" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding android:key="feature" android:value="@array/shortcut_schedule_aliases" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="grades" android:shortcutShortLabel="@string/shortcut_grades" android:shortcutLongLabel="@string/shortcut_grades" android:icon="@drawable/shortcut_grades">
