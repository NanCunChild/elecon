            <parameter-binding android:key="feature" android:value="@array/shortcut_grades_aliases" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="exam" android:shortcutShortLabel="@string/shortcut_exam" android:shortcutLongLabel="@string/shortcut_exam" android:icon="@drawable/shortcut_exam">
