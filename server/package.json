{
  "name": "@elecon/server",
  "version": "0.1.0",
  "private": true,
  "description": "elecon 服务端（Node/TS）：public 公网哑服务 + campus 校内授权中继。adapter 用 QuickJS-wasm 执行。见 docs/adr/adr_005_runtime.md。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:public": "tsx watch src/public/index.ts",
    "dev:campus": "tsx watch src/campus/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:public": "node dist/public/index.js",
    "start:campus": "node dist/campus/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:sandbox": "tsx src/runtime/sandbox.smoke.ts",
    "smoke:imperative": "tsx src/runtime/sandbox.imperative.smoke.ts",
    "smoke:broker": "tsx src/runtime/broker/inject-policy.smoke.ts",
    "smoke:dataflow": "tsx src/runtime/broker/dataflow.smoke.ts",
    "smoke:masker": "tsx src/runtime/broker/response-masker.smoke.ts",
    "smoke:masker-commit": "tsx src/runtime/broker/masker-commit.smoke.ts",
    "smoke:delivery-firewall": "tsx src/runtime/broker/delivery-firewall.smoke.ts",
    "smoke:urlmatch": "tsx src/runtime/broker/url-match.smoke.ts",
    "smoke:credential": "tsx src/runtime/credential/store.smoke.ts",
    "smoke:header": "tsx src/runtime/broker/header-sanitize.smoke.ts",
    "smoke:redirect": "tsx src/runtime/broker/redirect.smoke.ts",
    "smoke:cookie": "tsx src/runtime/broker/cookie-jar.smoke.ts",
    "smoke:harvest": "tsx src/runtime/broker/harvest.smoke.ts",
    "smoke:assemble": "tsx src/runtime/broker/assemble.smoke.ts",
    "smoke:transport": "tsx src/runtime/transport/direct.smoke.ts",
    "audit": "npm audit --omit=dev",
    "smoke:xjt": "tsx src/runtime/adapters-xjt.imperative.smoke.ts",
    "smoke:xidian-schedule": "tsx src/runtime/adapters-xidian.schedule.imperative.smoke.ts",
    "smoke:xidian-grades": "tsx src/runtime/adapters-xidian.grades.imperative.smoke.ts",
    "smoke:xidian-exams": "tsx src/runtime/adapters-xidian.exams.imperative.smoke.ts",
    "smoke:xidian-classroom": "tsx src/runtime/adapters-xidian.classroom.imperative.smoke.ts",
    "smoke:xidian-card": "tsx src/runtime/adapters-xidian.card.imperative.smoke.ts",
    "smoke:fudan-notice": "tsx src/runtime/adapters-fudan.notice.declarative.smoke.ts",
    "smoke:public": "tsx src/public/public.smoke.ts",
    "smoke:all": "node ../scripts/run-smokes.mjs src"
  },
  "dependencies": {
    "@elecon/broker-primitives": "*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
