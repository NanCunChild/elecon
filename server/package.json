{
  "name": "@elecon/server",
  "version": "0.1.0",
  "private": true,
  "description": "elecon 服务端（Node/TS）：public 公网哑服务 + campus 校内授权中继。adapter 用 QuickJS-wasm 执行。见 docs/adr/adr_005_runtime.md。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:public": "tsx watch src/public/index.ts",
    "dev:campus": "tsx watch src/campus/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:public": "node dist/public/index.js",
    "start:campus": "node dist/campus/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:sandbox": "tsx src/runtime/sandbox.smoke.ts",
    "smoke:fetch": "tsx src/runtime/sandbox.fetch.smoke.ts",
    "smoke:broker": "tsx src/runtime/broker/inject-policy.smoke.ts",
    "smoke:urlmatch": "tsx src/runtime/broker/url-match.smoke.ts",
    "smoke:credential": "tsx src/runtime/credential/store.smoke.ts",
    "smoke:header": "tsx src/runtime/broker/header-sanitize.smoke.ts",
    "smoke:redirect": "tsx src/runtime/broker/redirect.smoke.ts",
    "smoke:cookie": "tsx src/runtime/broker/cookie-jar.smoke.ts",
    "smoke:harvest": "tsx src/runtime/broker/harvest.smoke.ts",
    "smoke:assemble": "tsx src/runtime/broker/assemble.smoke.ts",
    "smoke:transport": "tsx src/runtime/transport/direct.smoke.ts",
    "audit": "npm audit --omit=dev",
    "smoke:xjt": "tsx src/runtime/adapters-xjt.fetch.smoke.ts",
    "smoke:all": "npm run smoke:sandbox && npm run smoke:fetch && npm run smoke:broker && npm run smoke:urlmatch && npm run smoke:credential && npm run smoke:header && npm run smoke:redirect && npm run smoke:cookie && npm run smoke:harvest && npm run smoke:assemble && npm run smoke:transport && npm run smoke:xjt"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
