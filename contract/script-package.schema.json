        },
        {"if": {"required": ["cards"], "properties": {"cards": {}}}, "then": {"properties": {"sdkVersion": {"enum": [6, 7, 8, 9, 10]}}}},
        {
          "if": {
            "required": ["cards"],
            "properties": {
              "cards": {
                "type": "array",
                "contains": {"type": "object", "required": ["type"], "properties": {"type": {"const": "notice"}}}
              }
            }
          },
          "then": {
            "properties": {
              "cards": {
                "type": "array",
                "contains": {"type": "object", "required": ["type"], "properties": {"type": {"const": "notice"}}},
                "maxContains": 1
              },
              "capabilities": {
                "type": "array",
                "allOf": [{"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "notice.list"}}}}]
              }
            }
          }
