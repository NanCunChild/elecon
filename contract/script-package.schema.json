        "cards": {
          "description": "SDK 6 only: optional host-owned card suggestions. User preferences take precedence; no executable layout or new data access.",
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "defaultVariant"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["notice", "schedule", "grades", "card", "library", "exam", "classroom", "energy", "climate", "generic"],
                "description": "Stable host business-card type; the package must provide all its required capabilities."
              },
              "defaultVariant": {
                "type": "string",
                "enum": ["compact", "regular", "expanded"],
                "description": "Suggested host presentation; only notice, schedule, grades and library support compact/expanded in this version."
              }
            },
            "allOf": [
              {
                "if": {"properties": {"type": {"enum": ["notice", "schedule", "grades", "library"]}}},
                "else": {"properties": {"defaultVariant": {"const": "regular"}}}
              }
            ]
          }
        }
