      "allOf": [
        {"if": {"required": ["scanner"], "properties": {"scanner": {}}}, "then": {"properties": {"sdkVersion": {"type": "integer", "minimum": 8}}}},
        {"if": {"required": ["homeTitle"], "properties": {"homeTitle": {}}}, "then": {"properties": {"sdkVersion": {"enum": [7, 8, 9, 10]}}}},
        {
          "if": {
            "required": [
