{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.script-package",
  "title": "Trusted school source package (ADR-034)",
  "description": "Validated before execution. Package text is at most 1 MiB UTF-8; domains/CIDR are additionally parsed by the host. Source is never evaluated by this validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "manifest",
    "source"
  ],
  "properties": {
    "format": {
      "const": "elecon-script/1"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdkVersion",
        "id",
        "version",
        "schoolId",
        "name",
        "network",
        "browser",
        "capabilities"
      ],
      "properties": {
        "sdkVersion": {
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "schoolId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "browser": {
          "type": "boolean"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origins"
          ],
          "properties": {
            "origins": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https?://(?:[a-zA-Z0-9.-]+|\\[[0-9a-fA-F:.]+\\])(?::[0-9]{1,5})?/?$"
              }
            },
            "ipAllow": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[0-9a-fA-F:.]+(?:/[0-9]{1,3})?$"
              }
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "schema",
                  "schemaVersion"
                ],
                "properties": {
                  "id": {
                    "const": "grades.list"
                  },
                  "schema": {
                    "const": "elecon.grades.list"
                  },
                  "schemaVersion": {
                    "const": "1.1"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "schema",
                  "schemaVersion"
                ],
                "properties": {
                  "id": {
                    "const": "schedule.week"
