{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.schedule.week",
  "title": "周课表",
  "type": "object",
  "required": [
    "term",
    "week",
    "days"
  ],
  "properties": {
    "term": {
      "type": "string",
      "description": "学期标识，如 2025-2026-2。"
    },
    "academicYear": {
      "type": "string",
      "description": "课表所属学年；缺失表示来源未提供。"
    },
    "termStartDate": {
      "type": "string",
      "format": "date",
      "description": "学期开始日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
    },
    "termEndDate": {
      "type": "string",
      "format": "date",
      "description": "学期结束日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
    },
    "teachingWeekStart": {
      "type": "string",
      "format": "date",
      "description": "本教学周开始日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
    },
    "teachingWeekEnd": {
      "type": "string",
      "format": "date",
      "description": "本教学周结束日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
    },
    "weekType": {
      "type": "string",
      "enum": [
        "teaching",
        "exam",
        "holiday",
        "unknown"
      ],
      "description": "周次类型：教学周、考试周、假期或未知；缺失表示来源未提供。"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "课表数据更新时间，RFC3339/UTC；缺失表示来源未提供。"
    },
    "sourceSystem": {
      "type": "string",
      "description": "课表数据的来源系统；缺失表示来源未提供。"
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "description": "教学周序号，从 1 开始。"
    },
    "days": {
      "type": "array",
      "description": "本周按星期组织的课表。",
      "items": {
        "type": "object",
        "required": [
          "dayOfWeek",
          "slots"
        ],
        "properties": {
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "星期序号，1 至 7。"
          },
          "slots": {
            "type": "array",
            "description": "当天的课程时段列表。",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "courseName"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "description": "课程开始节次标签。"
                },
                "end": {
                  "type": "string",
                  "description": "课程结束节次标签。"
                },
                "courseName": {
                  "type": "string",
                  "description": "课程名称。"
                },
                "courseId": {
                  "type": "string",
                  "description": "校内作用域的课程标识；缺失表示来源未提供。"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "description": "本次课程的日历日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
                },
                "timeStart": {
                  "type": "string",
                  "description": "课程开始墙钟时间或节次标签；缺失表示来源未提供。"
                },
                "timeEnd": {
                  "type": "string",
                  "description": "课程结束墙钟时间或节次标签；缺失表示来源未提供。"
                },
                "campus": {
                  "type": "string",
                  "description": "上课校区；缺失表示来源未提供。"
                },
                "building": {
                  "type": "string",
                  "description": "上课楼栋；缺失表示来源未提供。"
                },
                "room": {
                  "type": "string",
                  "description": "上课教室；缺失表示来源未提供。"
                },
                "roomCapacity": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "教室容量，单位为人数；缺失表示来源未提供。"
                },
                "courseNature": {
                  "type": "string",
                  "description": "学校定义的课程性质；缺失表示来源未提供。"
                },
                "classNo": {
                  "type": "string",
                  "description": "教学班号；缺失表示来源未提供。"
                },
                "language": {
                  "type": "string",
                  "description": "课程教学语言；缺失表示来源未提供。"
                },
                "courseUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "课程页面链接；缺失表示来源未提供。"
                },
                "group": {
                  "type": "string",
                  "description": "合班或分组信息；缺失表示来源未提供。"
                },
                "onlineUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "线上课程地址；缺失表示来源未提供。"
                },
                "meetingNumberPresent": {
                  "type": "boolean",
                  "description": "来源是否提供会议号；仅表示是否存在，不包含会议号值。"
                },
                "meetingPasswordPresent": {
                  "type": "boolean",
                  "description": "来源是否提供会议密码；仅表示是否存在，不包含密码值。"
                },
                "changeType": {
                  "type": "string",
                  "enum": [
                    "none",
                    "rescheduled",
                    "cancelled",
                    "makeup",
                    "substitute",
                    "temporaryRoom",
                    "unknown"
                  ],
                  "description": "课程变更类型：无变更、调课、停课、补课、代课、临时教室或未知；缺失表示来源未提供。"
                },
                "changeReason": {
                  "type": "string",
                  "description": "课程安排变更原因；缺失表示来源未提供。"
                },
                "weekExceptions": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "teacher": {
                  "type": "string",
                  "description": "授课教师；缺失表示来源未提供。"
                },
                "location": {
                  "type": "string",
                  "description": "来源提供的非结构化上课地点；缺失表示来源未提供。"
                },
                "weeks": {
                  "type": "array",
                  "description": "该课程实际上课的教学周序号列表；缺失表示来源未提供。",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "timeSegments": {
      "type": "array",
      "maxItems": 48,
      "description": "学校本地墙钟的上课时间分段，按开始时间升序且不重叠；缺失或空表示使用宿主时间轴，次序或范围无效时回退且保留全部课程。",
      "items": {
        "type": "object",
        "required": [
          "label",
          "timeStart",
          "timeEnd"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "该分段的学校节次或时段名称。"
          },
          "timeStart": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "同日分段开始墙钟时间 HH:mm，必须早于 timeEnd。"
          },
          "timeEnd": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "同日分段结束墙钟时间 HH:mm，必须晚于 timeStart。"
          }
        }
      }
    },
    "weekPreviews": {
      "type": "array",
      "maxItems": 100,
      "description": "同学期各周已知排课摘要；缺失的周或日表示未知，不表示无课；不声明学期总周数。",
      "items": {
        "type": "object",
        "required": [
          "week",
          "days"
        ],
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "摘要对应教学周序号，从 1 开始；同一周不重复。"
          },
          "days": {
            "type": "array",
            "maxItems": 7,
            "description": "已知星期的连续排课项数量；同一星期不重复。",
            "items": {
              "type": "object",
              "required": [
                "dayOfWeek",
                "courseCount"
              ],
              "properties": {
                "dayOfWeek": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7,
                  "description": "星期序号，1 至 7。"
                },
                "courseCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "description": "该日调停课后去重的连续排课项数；0 表示已知无课，不是课时数。"
                }
              }
            }
          }
        }
      }
    },
    "termWeeks": {
      "type": "array",
      "maxItems": 100,
      "description": "ADR-054：与本次数据同时获取的同一学期各周完整详情；仅对枚举的周声明完整性，未枚举周为未知，不据预览推断。周序号唯一，原始取得时间适用于整份快照。",
      "items": {
        "type": "object",
        "required": [
          "week",
          "teachingWeekStart",
          "teachingWeekEnd",
          "days"
        ],
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "同一学期的教学周序号，从 1 开始且在此数组内唯一。"
          },
          "teachingWeekStart": {
            "type": "string",
            "format": "date",
            "description": "本教学周开始日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
          },
          "teachingWeekEnd": {
            "type": "string",
            "format": "date",
            "description": "本教学周结束日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
          },
          "weekType": {
            "type": "string",
            "enum": [
              "teaching",
              "exam",
              "holiday",
              "unknown"
            ],
            "description": "周次类型：教学周、考试周、假期或未知；缺失表示来源未提供。"
          },
          "days": {
            "type": "array",
            "description": "此明确教学周的完整七日课程；空数组表示该周无课。",
            "items": {
              "type": "object",
              "required": [
                "dayOfWeek",
                "slots"
              ],
              "properties": {
                "dayOfWeek": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7,
                  "description": "星期序号，1 至 7。"
                },
                "slots": {
                  "type": "array",
                  "description": "当天的课程时段列表。",
                  "items": {
                    "type": "object",
                    "required": [
                      "start",
                      "end",
                      "courseName"
                    ],
                    "properties": {
                      "start": {
                        "type": "string",
                        "description": "课程开始节次标签。"
                      },
                      "end": {
                        "type": "string",
                        "description": "课程结束节次标签。"
                      },
                      "courseName": {
                        "type": "string",
                        "description": "课程名称。"
                      },
                      "courseId": {
                        "type": "string",
                        "description": "校内作用域的课程标识；缺失表示来源未提供。"
                      },
                      "date": {
                        "type": "string",
                        "format": "date",
                        "description": "本次课程的日历日，格式为 YYYY-MM-DD；缺失表示来源未提供。"
                      },
                      "timeStart": {
                        "type": "string",
                        "description": "课程开始墙钟时间或节次标签；缺失表示来源未提供。"
                      },
                      "timeEnd": {
                        "type": "string",
                        "description": "课程结束墙钟时间或节次标签；缺失表示来源未提供。"
                      },
                      "campus": {
                        "type": "string",
                        "description": "上课校区；缺失表示来源未提供。"
                      },
                      "building": {
                        "type": "string",
                        "description": "上课楼栋；缺失表示来源未提供。"
                      },
                      "room": {
                        "type": "string",
                        "description": "上课教室；缺失表示来源未提供。"
                      },
                      "roomCapacity": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "教室容量，单位为人数；缺失表示来源未提供。"
                      },
                      "courseNature": {
                        "type": "string",
                        "description": "学校定义的课程性质；缺失表示来源未提供。"
                      },
                      "classNo": {
                        "type": "string",
                        "description": "教学班号；缺失表示来源未提供。"
                      },
                      "language": {
                        "type": "string",
                        "description": "课程教学语言；缺失表示来源未提供。"
                      },
                      "courseUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "课程页面链接；缺失表示来源未提供。"
                      },
                      "group": {
                        "type": "string",
                        "description": "合班或分组信息；缺失表示来源未提供。"
                      },
                      "onlineUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "线上课程地址；缺失表示来源未提供。"
                      },
                      "meetingNumberPresent": {
                        "type": "boolean",
                        "description": "来源是否提供会议号；仅表示是否存在，不包含会议号值。"
                      },
                      "meetingPasswordPresent": {
                        "type": "boolean",
                        "description": "来源是否提供会议密码；仅表示是否存在，不包含密码值。"
                      },
                      "changeType": {
                        "type": "string",
                        "enum": [
                          "none",
                          "rescheduled",
                          "cancelled",
                          "makeup",
                          "substitute",
                          "temporaryRoom",
                          "unknown"
                        ],
                        "description": "课程变更类型：无变更、调课、停课、补课、代课、临时教室或未知；缺失表示来源未提供。"
                      },
                      "changeReason": {
                        "type": "string",
                        "description": "课程安排变更原因；缺失表示来源未提供。"
                      },
                      "weekExceptions": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "description": "明确不安排此课程的教学周序号；缺失表示未提供例外。"
                      },
                      "teacher": {
                        "type": "string",
                        "description": "授课教师；缺失表示来源未提供。"
                      },
                      "location": {
                        "type": "string",
                        "description": "来源提供的非结构化上课地点；缺失表示来源未提供。"
                      },
                      "weeks": {
                        "type": "array",
                        "description": "该课程实际上课的教学周序号列表；缺失表示来源未提供。",
                        "items": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            },
            "maxItems": 7
          }
        }
      }
    }
  }
}
