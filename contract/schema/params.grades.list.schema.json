{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.params.grades.list",
  "$comment": "ADR-082：filters为学校自有字段值；term既有标准含义不变。",
  "title": "grades.list 入参",
  "type": "object",
  "properties": {
    "term": {
      "type": "string",
      "description": "学期标识，如 2025-2026-2；省略 = 当前学期（ADR-001 §3.4 缺失语义）"
    },
    "filters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^(?!(?:prototype|constructor|__proto__)$)[a-z][a-zA-Z0-9._-]{0,63}$",
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 5,
                "description": "同日开始墙钟时刻，HH:mm；必须早于end。",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
              },
              "end": {
                "type": "string",
                "maxLength": 5,
                "description": "同日结束墙钟时刻，HH:mm；不含该时刻。",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
              }
            }
          }
        ]
      },
      "description": "query.controls 2.0同来源字段值，最多32项/32KiB UTF-8；仅同包声明新表单时使用。学校脚本重验字段和组合，不提升为其他宿主参数；省略保留旧标准参数行为。"
    }
  }
}
