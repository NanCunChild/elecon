{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.app.announcement",
  "title": "应用公告",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "items": {
      "type": "array",
      "description": "应用公告条目列表；缺失表示来源未提供公告列表。",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "公告标题；缺失表示来源未提供标题。" },
          "content": { "type": "string", "description": "公告正文内容；缺失表示来源未提供正文。" },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "description": "公告发布时间，格式为 RFC3339/UTC；缺失表示来源未提供可确认的发布时间。"
          },
          "privacyUrl": {
            "type": "string",
            "format": "uri",
            "description": "隐私政策页面 URI；缺失表示来源未提供该链接。"
          }
        }
      }
    }
  }
}
