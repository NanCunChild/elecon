{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.messages.history",
  "title": "消息历史页",
  "description": "ADR-061：仅前台；由核心按服务账号保护本地消息，脚本不访问数据库。",
  "type": "object",
  "properties": {
    "serviceId": {
      "type": "string",
      "description": "稳定服务标识；不按显示名合并。",
      "minLength": 1,
      "maxLength": 128
    },
    "accountId": {
      "type": "string",
      "description": "本次核验的远端服务账号 ID；须与请求账号一致。",
      "minLength": 1,
      "maxLength": 128
    },
    "accountLabel": {
      "type": "string",
      "description": "账号显示名；空表示未提供。",
      "minLength": 0,
      "maxLength": 160
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time",
      "description": "本次源站读取或发送核验完成的时刻，RFC3339；本地读取不更新。"
    },
    "conversationId": {
      "type": "string",
      "description": "源站会话 ID；由 serviceId/accountId/conversationKind 共同限定。",
      "minLength": 1,
      "maxLength": 128
    },
    "conversationKind": {
      "type": "string",
      "description": "group 群聊，direct 私聊；相同 ID 的不同类型不合并。",
      "enum": [
        "group",
        "direct"
      ]
    },
    "hasMore": {
      "type": "boolean",
      "description": "源站明确存在下一页时为 true；false 表示本次游标到源站历史末尾，非本地库完整性。"
    },
    "nextCursor": {
      "type": "string",
      "description": "下一页不透明游标，仅 hasMore=true 时提供；不得转浮点或跨账号/会话使用。",
      "minLength": 1,
      "maxLength": 512
    },
    "items": {
      "type": "array",
      "description": "本页规范消息，按发送时间升序；跨页可重复，按会话和 id 去重。",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "源站稳定消息 ID；十进制大整数保留字符串。",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "description": "纯文本消息或附件摘要，不是 HTML/可执行链接；撤回记录不含原文。",
            "minLength": 1,
            "maxLength": 8000
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "video",
              "voice",
              "file",
              "location",
              "activity",
              "command",
              "course",
              "homework",
              "task",
              "unknown"
            ],
            "description": "ADR-066：有限内容类型；activity/command只展示标识与纯文本摘要，不执行指令或活动。"
          },
          "direction": {
            "type": "string",
            "description": "相对于本次核验账号的发送方向。",
            "enum": [
              "incoming",
              "outgoing"
            ]
          },
          "senderId": {
            "type": "string",
            "description": "源站发送者 ID，未知省略。",
            "minLength": 1,
            "maxLength": 128
          },
          "senderLabel": {
            "type": "string",
            "description": "发送者显示名，未知省略。",
            "minLength": 1,
            "maxLength": 160
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "description": "源站明确给出的发送时刻，RFC3339；未知省略。"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "direction"
        ]
      }
    },
    "recalledIds": {
      "type": "array",
      "description": "已撤回消息 ID；墓碑覆盖所有已存和后续补到的旧正文。",
      "maxItems": 200,
      "items": {
        "type": "string",
        "description": "源站被撤回消息 ID。",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sendPermission": {
      "type": "string",
      "enum": [
        "allowed",
        "muted",
        "unknown"
      ],
      "description": "ADR-066：当前账号发送权限；allowed须来自当前源站核验，muted表示确认禁言/停用，unknown表示缺少证据。历史缓存不能授权发送。"
    },
    "sendPermissionReason": {
      "type": "string",
      "enum": [
        "member_muted",
        "group_muted",
        "group_disabled",
        "verification_failed"
      ],
      "description": "固定原因；不含源站异常或敏感信息。缺失时仅按sendPermission展示。"
    }
  },
  "required": [
    "serviceId",
    "accountId",
    "accountLabel",
    "fetchedAt",
    "conversationId",
    "conversationKind",
    "hasMore",
    "items",
    "recalledIds"
  ]
}
