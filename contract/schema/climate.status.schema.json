{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.climate.status",
  "title": "空调状态",
  "$comment": "ADR-040: accepted 2026-10-31; new trusted-script route.",
  "type": "object",
  "description": "空调状态",
  "properties": {
    "deviceId": {
      "type": "string",
      "description": "本次状态对应的已绑定设备。",
      "minLength": 1,
      "maxLength": 128
    },
    "power": {
      "type": "boolean",
      "description": "目标电源开关；非本次变更则省略。"
    },
    "mode": {
      "type": "string",
      "description": "目标模式；非本次变更则省略。",
      "enum": [
        "fan",
        "heat",
        "cool",
        "dry",
        "auto"
      ]
    },
    "fanSpeed": {
      "type": "string",
      "description": "目标风速；非本次变更则省略。",
      "enum": [
        "auto",
        "silent",
        "low",
        "medium",
        "high"
      ]
    },
    "targetTemperature": {
      "type": "integer",
      "minimum": 16,
      "maximum": 32,
      "description": "目标摄氏温度；还须满足该设备范围。"
    },
    "verticalSwing": {
      "type": "boolean",
      "description": "目标上下扫风开关。"
    },
    "turbo": {
      "type": "boolean",
      "description": "目标强力开关。"
    },
    "auxiliaryHeat": {
      "type": "boolean",
      "description": "目标辅热开关。"
    },
    "indoorTemperature": {
      "type": "number",
      "description": "室内摄氏温度；未提供时省略。"
    },
    "remainingEnergy": {
      "type": "number",
      "description": "剩余电量，与 unit 同单位；来源不能证明语义时省略。"
    },
    "unit": {
      "type": "string",
      "description": "remainingEnergy 的单位；缺失余量时可省略。"
    },
    "observedAt": {
      "type": "string",
      "description": "设备状态采样时刻，RFC3339/UTC；未知时省略。",
      "format": "date-time"
    },
    "errorCode": {
      "type": "string",
      "description": "净化后的设备错误分类，不含远端原始消息。"
    },
    "online": {
      "type": "boolean",
      "description": "设备明确报告的在线状态；未知时省略。"
    },
    "indoorClean": {
      "type": "boolean",
      "description": "本次操作联动的清洁模式开关；仅用于完整确认及状态核验，不新增独立控制项。"
    },
    "outdoorClean": {
      "type": "boolean",
      "description": "本次操作联动的清洁模式开关；仅用于完整确认及状态核验，不新增独立控制项。"
    }
  },
  "required": [
    "deviceId"
  ]
}
