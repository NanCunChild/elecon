{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.params.classroom.available",
  "title": "空教室查询参数",
  "type": "object",
  "description": "双时间轴：墙钟（date+start/end）与/或节次（date/week/term + sectionStart/End）。字段组合由宿主与 adapter 约定；tools 不做 oneOf 强校验。见 ADR-019。",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "查询日历日 YYYY-MM-DD"
    },
    "term": {
      "type": "string",
      "description": "学期标识，如 2025-2026-2；省略=当前学期（若源站需要）"
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "description": "教学周序号"
    },
    "weekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "星期 1=周一 … 7=周日"
    },
    "campus": {
      "type": "string",
      "description": "校区名称或校内 code（校作用域）"
    },
    "building": {
      "type": "string",
      "description": "教学楼展示名；模糊匹配时 adapter 自定，优先用 buildingId"
    },
    "buildingId": {
      "type": "string",
      "description": "教学楼校内 id/code（如西电 JXLDM）"
    },
    "room": {
      "type": "string",
      "description": "教室展示名过滤"
    },
    "roomId": {
      "type": "string",
      "description": "教室校内 id"
    },
    "start": {
      "type": "string",
      "description": "窗口起点，推荐 HH:mm（墙钟）"
    },
    "end": {
      "type": "string",
      "description": "窗口终点，推荐 HH:mm（墙钟）"
    },
    "timeZone": {
      "type": "string",
      "description": "IANA 时区；调用方可选提示；权威声明在 adapter emits"
    },
    "sectionStart": {
      "type": "integer",
      "minimum": 1,
      "description": "节次窗口起点（含），1-based"
    },
    "sectionEnd": {
      "type": "integer",
      "minimum": 1,
      "description": "节次窗口终点（含），1-based；须 ≥ sectionStart"
    },
    "onlyAvailable": {
      "type": "boolean",
      "description": "true=只返回在查询窗口内判定为空闲的教室；默认 false=返回楼内对照列表"
    },
    "filters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^(?!(?:prototype|constructor|__proto__)$)[a-z][a-zA-Z0-9._-]{0,63}$",
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 5,
                "description": "同日开始墙钟时刻，HH:mm；必须早于end。",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
              },
              "end": {
                "type": "string",
                "maxLength": 5,
                "description": "同日结束墙钟时刻，HH:mm；不含该时刻。",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
              }
            }
          }
        ]
      },
      "description": "query.controls 2.0同来源字段值，最多32项/32KiB UTF-8；仅同包声明新表单时使用。学校脚本重验字段和组合，不提升为其他宿主参数；省略保留旧标准参数行为。"
    }
  }
}
