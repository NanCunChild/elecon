{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.params.climate.command",
  "title": "空调控制参数",
  "$comment": "ADR-040: accepted 2026-10-31; new trusted-script route.",
  "type": "object",
  "description": "空调控制参数",
  "properties": {
    "deviceId": {
      "type": "string",
      "description": "当前身份已绑定并通过查询验证的设备。",
      "minLength": 1,
      "maxLength": 128
    },
    "command": {
      "type": "string",
      "description": "有限控制项；settings 必须与该操作及设备联动规则一致。",
      "enum": [
        "power",
        "temperature",
        "mode",
        "fanSpeed",
        "verticalSwing",
        "turbo",
        "auxiliaryHeat"
      ]
    },
    "settings": {
      "type": "object",
      "description": "用户确认的完整目标变更；不接受任意学校 JSON。",
      "properties": {
        "power": {
          "type": "boolean",
          "description": "目标电源开关；非本次变更则省略。"
        },
        "mode": {
          "type": "string",
          "description": "目标模式；非本次变更则省略。",
          "enum": [
            "fan",
            "heat",
            "cool",
            "dry",
            "auto"
          ]
        },
        "fanSpeed": {
          "type": "string",
          "description": "目标风速；非本次变更则省略。",
          "enum": [
            "auto",
            "silent",
            "low",
            "medium",
            "high"
          ]
        },
        "targetTemperature": {
          "type": "integer",
          "minimum": 16,
          "maximum": 32,
          "description": "目标摄氏温度；还须满足该设备范围。"
        },
        "verticalSwing": {
          "type": "boolean",
          "description": "目标上下扫风开关。"
        },
        "turbo": {
          "type": "boolean",
          "description": "目标强力开关。"
        },
        "auxiliaryHeat": {
          "type": "boolean",
          "description": "目标辅热开关。"
        },
        "indoorClean": {
          "type": "boolean",
          "description": "本次操作联动的清洁模式开关；仅用于完整确认及状态核验，不新增独立控制项。"
        },
        "outdoorClean": {
          "type": "boolean",
          "description": "本次操作联动的清洁模式开关；仅用于完整确认及状态核验，不新增独立控制项。"
        }
      }
    }
  },
  "required": [
    "deviceId",
    "command",
    "settings"
  ]
}
