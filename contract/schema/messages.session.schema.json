{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.messages.session",
  "title": "服务账号状态",
  "description": "ADR-052：前台调用，不预加载或持久缓存。",
  "type": "object",
  "properties": {
    "serviceId": {
      "type": "string",
      "description": "脚本定义的稳定服务标识；与安装来源一起确定服务。",
      "minLength": 1,
      "maxLength": 128
    },
    "serviceName": {
      "type": "string",
      "description": "服务的显示名称；纯文本。",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "description": "authenticated 仅在源站核验账号后返回；signedOut 为本地无有效会话。",
      "enum": [
        "authenticated",
        "signedOut"
      ]
    },
    "accountId": {
      "type": "string",
      "description": "源站稳定账号 ID，按字符串处理；未登录时省略。",
      "minLength": 1,
      "maxLength": 128
    },
    "accountLabel": {
      "type": "string",
      "description": "当前账号展示名；未登录时省略。",
      "maxLength": 160
    }
  },
  "required": [
    "serviceId",
    "serviceName",
    "status"
  ]
}
