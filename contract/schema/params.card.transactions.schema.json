{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.params.card.transactions",
  "$comment": "草案：入参形状待 ADR 确认（红线 #6）。日期范围 + 分页为常见取数约定，需结合真实接口校准。",
  "title": "card.transactions 入参",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "format": "date",
      "description": "起始日期（含）；省略 = 接口默认窗口"
    },
    "to": {
      "type": "string",
      "format": "date",
      "description": "结束日期（含）；省略 = 至今"
    },
    "page": { "type": "integer", "minimum": 1, "description": "页码，从 1 起" },
    "size": { "type": "integer", "minimum": 1, "description": "每页条数" }
  }
}
