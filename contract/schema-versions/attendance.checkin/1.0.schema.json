{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.attendance.checkin",
  "title": "扫码签到结果",
  "description": "ADR-052：前台调用，不预加载或持久缓存。",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "description": "confirmed/already 需状态核验；unknown 表示副作用可能已发生且不可自动重发。",
      "enum": [
        "confirmed",
        "already",
        "ended",
        "unsupported",
        "cancelled",
        "rejected",
        "unknown"
      ]
    },
    "activityId": {
      "type": "string",
      "description": "已严格解析的活动 ID；取消或无有效二维码时省略。",
      "maxLength": 128
    }
  },
  "required": [
    "status"
  ]
}
