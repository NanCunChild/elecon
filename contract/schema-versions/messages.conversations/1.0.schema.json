{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.messages.conversations",
  "title": "消息会话列表",
  "description": "ADR-061：仅前台；由核心按服务账号保护本地消息，脚本不访问数据库。",
  "type": "object",
  "properties": {
    "serviceId": {
      "type": "string",
      "description": "稳定服务标识；不按显示名合并。",
      "minLength": 1,
      "maxLength": 128
    },
    "accountId": {
      "type": "string",
      "description": "本次核验的远端服务账号 ID；须与请求账号一致。",
      "minLength": 1,
      "maxLength": 128
    },
    "accountLabel": {
      "type": "string",
      "description": "账号显示名；空表示未提供。",
      "minLength": 0,
      "maxLength": 160
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time",
      "description": "本次源站读取或发送核验完成的时刻，RFC3339；本地读取不更新。"
    },
    "coverage": {
      "type": "string",
      "description": "complete 表示源站完整返回群与联系人目录；partial 表示部分目录失败或超出界限，不代表历史完整性。",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "items": {
      "type": "array",
      "description": "当前账号可访问的群与联系人；不包含未读推断。",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "description": "源站会话 ID；由 serviceId/accountId/conversationKind 共同限定。",
            "minLength": 1,
            "maxLength": 128
          },
          "conversationKind": {
            "type": "string",
            "description": "group 群聊，direct 私聊；相同 ID 的不同类型不合并。",
            "enum": [
              "group",
              "direct"
            ]
          },
          "title": {
            "type": "string",
            "description": "会话显示名；服务未提供时使用会话 ID。",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "conversationId",
          "conversationKind",
          "title"
        ]
      }
    }
  },
  "required": [
    "serviceId",
    "accountId",
    "accountLabel",
    "fetchedAt",
    "coverage",
    "items"
  ]
}
