{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.climate.devices",
  "title": "已绑定空调设备",
  "$comment": "ADR-040: accepted 2026-10-31; new trusted-script route.",
  "type": "object",
  "description": "已绑定空调设备",
  "properties": {
    "items": {
      "type": "array",
      "description": "已由用户绑定且通过只读查询核验的设备。",
      "items": {
        "type": "object",
        "description": "一台设备及其有限控制范围。",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "当前学校身份下用户明确绑定的设备标识。",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "description": "用户友好名称，不包含完整设备标识。",
            "minLength": 1,
            "maxLength": 120
          },
          "minTemperature": {
            "type": "integer",
            "minimum": 16,
            "maximum": 32,
            "description": "设备最低设定摄氏温度。"
          },
          "maxTemperature": {
            "type": "integer",
            "minimum": 16,
            "maximum": 32,
            "description": "设备最高设定摄氏温度。"
          },
          "modes": {
            "type": "array",
            "description": "设备支持的模式。",
            "items": {
              "type": "string",
              "description": "模式值。",
              "enum": [
                "fan",
                "heat",
                "cool",
                "dry",
                "auto"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "fanSpeeds": {
            "type": "array",
            "description": "设备支持的风速。",
            "items": {
              "type": "string",
              "description": "风速值。",
              "enum": [
                "auto",
                "silent",
                "low",
                "medium",
                "high"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "commands": {
            "type": "array",
            "description": "设备允许的有限控制项。",
            "items": {
              "type": "string",
              "description": "控制项。",
              "enum": [
                "power",
                "temperature",
                "mode",
                "fanSpeed",
                "verticalSwing",
                "turbo",
                "auxiliaryHeat"
              ]
            },
            "maxItems": 7
          },
          "modeDefaults": {
            "type": "array",
            "description": "切模式时必须一并确认的完整设置；由提供者声明。",
            "items": {
              "type": "object",
              "description": "一个模式的联动目标。",
              "properties": {
                "power": {
                  "type": "boolean",
                  "description": "目标电源开关；非本次变更则省略。"
                },
                "mode": {
                  "type": "string",
                  "description": "目标模式；非本次变更则省略。",
                  "enum": [
                    "fan",
                    "heat",
                    "cool",
                    "dry",
                    "auto"
                  ]
                },
                "fanSpeed": {
                  "type": "string",
                  "description": "目标风速；非本次变更则省略。",
                  "enum": [
                    "auto",
                    "silent",
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "targetTemperature": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 32,
                  "description": "目标摄氏温度；还须满足该设备范围。"
                },
                "verticalSwing": {
                  "type": "boolean",
                  "description": "目标上下扫风开关。"
                },
                "turbo": {
                  "type": "boolean",
                  "description": "目标强力开关。"
                },
                "auxiliaryHeat": {
                  "type": "boolean",
                  "description": "目标辅热开关。"
                },
                "indoorClean": {
                  "type": "boolean",
                  "description": "本次操作联动的清洁模式开关；仅用于完整确认及状态核验，不新增独立控制项。"
                },
                "outdoorClean": {
                  "type": "boolean",
                  "description": "本次操作联动的清洁模式开关；仅用于完整确认及状态核验，不新增独立控制项。"
                }
              },
              "required": [
                "mode",
                "targetTemperature",
                "fanSpeed",
                "turbo",
                "auxiliaryHeat",
                "indoorClean",
                "outdoorClean"
              ]
            },
            "maxItems": 5
          },
          "powerOffClearsAuxiliaryHeat": {
            "type": "boolean",
            "description": "关机是否同时关闭辅热。"
          },
          "fanSpeedClearsTurbo": {
            "type": "boolean",
            "description": "设置风速是否同时关闭强力。"
          },
          "turboUsesAutoFan": {
            "type": "boolean",
            "description": "开启强力是否同时使用自动风速。"
          },
          "powerOffClearsCleaning": {
            "type": "boolean",
            "description": "关机是否同时关闭室内和室外清洁。"
          }
        },
        "required": [
          "deviceId",
          "label",
          "minTemperature",
          "maxTemperature",
          "modes",
          "fanSpeeds",
          "commands",
          "modeDefaults",
          "powerOffClearsAuxiliaryHeat",
          "fanSpeedClearsTurbo",
          "turboUsesAutoFan",
          "powerOffClearsCleaning"
        ]
      },
      "maxItems": 20
    }
  },
  "required": [
    "items"
  ]
}
