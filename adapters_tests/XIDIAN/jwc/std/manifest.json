{
  "manifestVersion": "1.0",
  "adapterId": "school-xidian-jwc-notice",
  "adapterVersion": "0.1.0",
  "schoolId": "xidian",
  "displayName": "西安电子科技大学 教务处（通知公告）",
  "trustTier": "sideload",
  "runtime": { "engine": "quickjs", "entry": "index.js" },
  "network": {
    "allow": ["https://jwc.xidian.edu.cn/"]
  },
  "capabilities": [
    {
      "id": "notice.list",
      "requestGraph": "declarative",
      "emits": { "schema": "elecon.notice.list", "schemaVersion": "1.1" },
      "params": { "schema": "elecon.params.notice.list", "schemaVersion": "1.0" },
      "requests": [
        { "key": "home", "method": "GET", "url": "https://jwc.xidian.edu.cn/" }
      ]
    }
  ]
}
