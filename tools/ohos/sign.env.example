# OHOS hap 签名材料（机器 + 华为账号相关私密物，**不入库**）。
# 复制为 tools/ohos/sign.env（已 gitignore），按你的实际路径填写。
#
# 这些材料来自华为开发者「调试签名」：
#   - .p12 keystore（含私钥）   - keyAlias（keystore 内别名，可用
#       `keytool -list -keystore <p12> -storetype PKCS12` 查看）
#   - 应用签名证书 .cer          - 调试 Profile .p7b
#   - 单行密码文件（keystore 与 key 同密码；不写明文进本文件）

export SIGN_KEYSTORE=/path/to/your_debug_key.p12
export SIGN_KEY_ALIAS=your_key_alias
export SIGN_APP_CERT=/path/to/Huawei_Debug.cer
export SIGN_PROFILE=/path/to/yourDebug.p7b
export SIGN_PWD_FILE=/path/to/password.txt
export SIGN_ALG=SHA256withECDSA
