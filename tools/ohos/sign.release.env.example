# OHOS hap 【release】签名材料（机器+账号相关私密物，红线 #8 精神：绝不入库）。
#   复制为 tools/ohos/sign.release.env（已 gitignore），把占位改成你本机实际路径/别名。
#   由 tools/ohos/build-hap.sh --release / sign-hap.sh ... --release 自助选用。
#
# 与 debug 的关键差异：
#   · SIGN_PROFILE 用【release/发布】profile .p7b——**不锁 UDID**（面向分发），由 AGC 按应用签发；
#   · 通常用独立的 release keystore / 证书（与 debug 分开保管）；
#   · release 产物是 AOT 包（体积远小于 debug 的 kernel_blob 包）。
#
# 字段含义同 debug（见 sign.debug.env.example）：
#   SIGN_KEYSTORE / SIGN_KEY_ALIAS / SIGN_APP_CERT / SIGN_PROFILE / SIGN_PWD_FILE / SIGN_ALG
#
# 换 profile/证书只改本文件，不动脚本；若 profile 的 bundle id 变了，须同步 AppScope/app.json5
# 的 bundleName 并 build-hap.sh --release 重编（bundle id 编进 hap，单独重签会 install 失败）。
export SIGN_KEYSTORE=/path/to/your/release/keystore.p12
export SIGN_KEY_ALIAS=your_release_key_alias
export SIGN_APP_CERT=/path/to/your/release/app_cert.cer
export SIGN_PROFILE=/path/to/your/release_profile.p7b
export SIGN_PWD_FILE=/path/to/your/release/password.txt
export SIGN_ALG=SHA256withECDSA
