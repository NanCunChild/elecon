#!/usr/bin/env bash
# OHOS / HarmonyOS 构建环境（source 用）—— Probe-001 工具链冒烟 / 后续 hap 构建。
#
# 设计：**只在需要时把变量带进当前 shell，永不污染主 shell**。两种干净用法——
#   1) 子 shell 包裹（一次性命令，退出即自动"脱掉"）：
#        ( source tools/ohos/env.sh && fvm spawn ohos/br_3.27.4-ohos-1.0.4 doctor )
#   2) direnv（日常，cd 进 client/ohos 自动加载、cd 出自动卸载）：见 client/ohos/.envrc.example
#   **不要**再写一个"脱环境变量"脚本——可靠地还原 PATH 很脆；子 shell / direnv 就是天然的卸载。
#
# 机器相关绝对路径不入库（红线 #8 精神）：本文件是 .example。
#   复制为 tools/ohos/env.sh（已 gitignore），按你的机器改 OHOS_CLI_HOME 即可。
#
# 幂等：重复 source 不会把同一段 PATH 越堆越长。

# —— 华为 Command Line Tools 安装根（改成你的路径）——
: "${OHOS_CLI_HOME:=/opt/ohos_cli_tools}"

if [ ! -d "$OHOS_CLI_HOME/bin" ]; then
  echo "[ohos] ✗ OHOS_CLI_HOME 无效：$OHOS_CLI_HOME（应含 bin/ ohpm/ hvigor/ sdk/ tool/）" >&2
  return 1 2>/dev/null || exit 1
fi

# HarmonyOS SDK：hvigor / ohpm 读 DEVECO_SDK_HOME；flutter 经 `flutter config --ohos-sdk` 持久化（见 README）。
export DEVECO_SDK_HOME="$OHOS_CLI_HOME/sdk"
# 内置 node（ohpm/hvigorw 包装器会自设，但显式更稳）。
export DEVECO_NODE_HOME="$OHOS_CLI_HOME/tool/node"

# 幂等 prepend：仅当尚不在 PATH 中才加。
_ohos_path_prepend() { case ":$PATH:" in *":$1:"*) :;; *) PATH="$1:$PATH";; esac; }
_ohos_path_prepend "$OHOS_CLI_HOME/bin"                                  # ohpm, hvigorw, codelinter
_ohos_path_prepend "$DEVECO_NODE_HOME/bin"                               # 内置 node v18
_ohos_path_prepend "$OHOS_CLI_HOME/sdk/default/openharmony/toolchains"   # hdc（真机 list/install）
export PATH
unset -f _ohos_path_prepend

echo "[ohos] DEVECO_SDK_HOME=$DEVECO_SDK_HOME"
echo "[ohos] ohpm=$(command -v ohpm) | hvigorw=$(command -v hvigorw) | hdc=$(command -v hdc) | node=$(command -v node)"
