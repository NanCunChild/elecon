# OHOS hap 【debug】签名材料（机器+账号相关私密物，红线 #8 精神：绝不入库）。
#   复制为 tools/ohos/sign.debug.env（已 gitignore），把占位改成你本机实际路径/别名。
#   由 tools/ohos/build-hap.sh（默认 debug）/ sign-hap.sh ... --debug 自助选用。
#
# 材料来源（华为 AppGallery Connect + 本地 keytool 生成）：
#   SIGN_KEYSTORE  —— 私钥库 .p12（PKCS12）。查别名：keytool -list -keystore <p12> -storetype PKCS12
#   SIGN_KEY_ALIAS —— 上面库里的密钥别名
#   SIGN_APP_CERT  —— 应用签名证书 .cer（AGC 用你的 CSR 签发）
#   SIGN_PROFILE   —— 【debug】profile .p7b：**锁本机平板 UDID**（hdc shell bm get --udid），
#                     换平板须在 AGC 用新 UDID 重签发；只改本文件路径后重跑 sign-hap.sh 即可（不重编）
#   SIGN_PWD_FILE  —— 单行密码文件（keystore 与 key 同口令时复用）
#   SIGN_ALG       —— 签名算法，EC 密钥用 SHA256withECDSA
#
# 换 profile/证书只改本文件，不动脚本；若 profile 的 bundle id 变了，须同步 AppScope/app.json5
# 的 bundleName 并 build-hap.sh 重编（bundle id 编进 hap，单独重签会 install 失败）。
export SIGN_KEYSTORE=/path/to/your/debug/keystore.p12
export SIGN_KEY_ALIAS=your_debug_key_alias
export SIGN_APP_CERT=/path/to/your/debug/app_cert.cer
export SIGN_PROFILE=/path/to/your/debug_profile.p7b
export SIGN_PWD_FILE=/path/to/your/debug/password.txt
export SIGN_ALG=SHA256withECDSA
