        "silentWeb": false
      }
    },
    {
      "id": "ruisi",
      "name": "睿思论坛账号",
      "instructions": "使用睿思独立注册的账号，与学校统一认证账号不同。先登录校园接入，再登录论坛。",
      "capabilities": [
        "forum.session",
        "account.session"
      ],
      "login": {
        "capability": "account.session",
        "params": {
          "account": "ruisi",
          "operation": "login"
        }
      },
      "status": {
        "capability": "account.session",
        "params": {
          "account": "ruisi",
          "operation": "status"
        }
      },
      "appTunnelAccountId": "apptunnel"
    },
    {
      "id": "apptunnel",
      "name": "校园接入 · APPTunnel",
      "instructions": "通过学校 aTrust 官方页面完成统一认证和二次验证。睿思请求使用此连接，其他功能按各自声明连接。",
      "capabilities": [
        "account.session"
      ],
      "status": {
        "capability": "account.session",
        "params": {
          "account": "apptunnel",
          "operation": "status"
        }
      },
      "login": {
        "capability": "account.session",
        "params": {
          "account": "apptunnel",
          "operation": "login"
        }
      },
